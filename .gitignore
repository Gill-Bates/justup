# ─── Python ───
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ─── Node (lint/test tooling only) ───
node_modules/
npm-debug.log*

# ─── Runtime data & secrets ───
/data/
.env
.env.*
!.env.example
# Bootstrap admin password (plaintext, 0600) and its atomic-write temp files, wherever JUSTUP_DATA_DIR points
.bootstrap-admin-credentials
.bootstrap-admin-credentials.*
*.log
*.tmp
*.bak
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ─── Generated at build time (commit SHA, see setup.conf / Dockerfile) ───
/BUILD_INFO

# ─── Vendored wheels: only the hash-pinned SSLyze wheel is committed ───
# Rebuild instructions: docker/vendor/sslyze/build-wheel.sh. Use dir/* (not dir/) so the re-include works.
docker/vendor/wheels/*
!docker/vendor/wheels/sslyze-6.3.1+justup.1-py3-none-any.whl

# ─── Archives & dumps ───
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.backup
full_codebase_*.txt
Architektur.txt

# ─── Windows/WSL metadata ───
*:Zone.Identifier
Thumbs.db
Desktop.ini
.DS_Store

