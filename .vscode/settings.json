{
    // No Prettier config in this repo: Stylelint, ESLint and Ruff are the formatting authorities.
    // Disable formatting for Jinja2 templates to preserve {{ }} syntax
    "[html]": {
        "editor.formatOnSave": false
    },
    // CSS: apply only Stylelint's autofixes on save (config lives in tools/)
    "[css]": {
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "explicit"
        }
    },
    "stylelint.configFile": "tools/stylelint.config.mjs",
    "stylelint.validate": ["css"],
    "[javascript]": {
        "editor.formatOnSave": false
    },
    "files.associations": {
        "*.html": "jinja-html"
    },
    // Python: Ruff is the single source of truth
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    // Prefer project pyproject.toml / ruff.toml over editor overrides
    "ruff.configurationPreference": "filesystemFirst",
    // MkDocs resolves these Python tags itself; the YAML extension does not know them.
    "yaml.customTags": [
        "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
        "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
        "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format"
    ]
}
