{
  "name": "justup-frontend-tooling",
  "private": true,
  "type": "module",
  "description": "Lint and test tooling for the hand-written frontend; nothing here is shipped.",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint -c tools/eslint.config.mjs app/static/js",
    "lint:css": "stylelint --config tools/stylelint.config.mjs \"app/static/css/ui.css\" \"app/static/css/gentelella-layout.css\" \"app/static/css/dashboard.css\" \"app/static/css/traceroute-map.css\" \"app/static/css/target-detail.css\" \"app/static/css/notifications.css\" \"app/static/css/target-wizard.css\"",
    "test": "node --test tests/js/*.test.mjs",
    "test:layout": "node tests/layout/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "js-yaml": "^4.3.2",
    "playwright": "^1.64.1",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
